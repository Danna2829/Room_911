{
  "name": "room-911",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de Control de Acceso Dinámico por Matriz de Riesgo y Cronograma",
  "scripts": {
    "instalar": "pnpm --dir front install",
    "frontend:dev": "pnpm --dir front start",
    "frontend:build": "pnpm --dir front build",
    "frontend:test": "pnpm --dir front test --watchAll=false",
    "backend:dev": "mvn -f back/Sala_911/pom.xml spring-boot:run",
    "backend:test": "mvn -f back/Sala_911/pom.xml test",
    "backend:package": "mvn -f back/Sala_911/pom.xml clean package",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "verificar": "pnpm frontend:build && pnpm backend:package"
  }
}
